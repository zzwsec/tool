mode: rule

log-level: warning
ipv6: true

profile:
  store-selected: false
  store-fake-ip: false

proxies:
  - name: "DIRECT-IPv4-PREFER"
    type: direct
    ip-version: ipv4-prefer

rule-providers:
  meituan:
    type: http
    behavior: domain
    format: mrs
    interval: 86400
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/meituan.mrs"

  private-ip:
    type: http
    behavior: ipcidr
    format: mrs
    interval: 86400
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/private.mrs"

listeners:
  - name: "VLESS-REALITY-IN"
    type: vless
    port: <PORT>
    listen: "::"
    users:
      - username: 1
        uuid: "<UUID>"              # uuidgen
        flow: xtls-rprx-vision
    reality-config:
      dest: <SNI>:443
      private-key: "PRIVATE-KEY"    # mihomo generate reality-keypair
      short-id: ["<SHORT-ID>"]
      server-names: ["<SNI>"]

rules:
  - RULE-SET,meituan,REJECT
  - DOMAIN-SUFFIX,ping0.cc,REJECT
  - RULE-SET,private-ip,REJECT
  - MATCH,DIRECT-IPv4-PREFER