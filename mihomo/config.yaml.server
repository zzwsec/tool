mode: rule

geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"

log-level: warning
ipv6: true

profile:
  store-selected: false
  store-fake-ip: false

proxies:
  - name: "DIRECT-IPv4-PREFER"
    type: direct
    ip-version: ipv4-prefer

listeners:
  # VLESS + REALITY + Vision
  - name: "VLESS-REALITY-IN"
    type: vless
    port: <PORT>
    listen: "::"
    users:
      - username: 1
        uuid: "<UUID>"              # uuidgen
        flow: xtls-rprx-vision
    reality-config:
      dest: <SNI>:443
      private-key: "PRIVATE-KEY"  # mihomo generate reality-keypair
      short-id: ["<SHORT-ID>"]
      server-names: ["<SNI>"]

rules:
  - GEOSITE,meituan,REJECT
  - DOMAIN-SUFFIX,ping0.cc,REJECT
  - GEOIP,private,REJECT
  - MATCH,DIRECT-IPv4-PREFER